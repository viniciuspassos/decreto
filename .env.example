# Copy to .env and adjust as needed. Host commands read DATABASE_URL here;
# Compose constructs its own URL with host `db` from the POSTGRES_* values.

POSTGRES_DB=decreto
POSTGRES_USER=decreto
POSTGRES_PASSWORD=decreto
POSTGRES_PORT=5432

API_PORT=3001
DATABASE_URL=postgresql://decreto:decreto@localhost:5432/decreto
# Relative to apps/api when running pnpm dev; containers use /repo/assets/images.
ASSETS_DIR=../../assets/images

WEB_PORT=8080
