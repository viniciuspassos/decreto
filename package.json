{
  "name": "decreto",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:db": "docker compose up -d --wait db",
    "dev:mocked": "turbo run dev --filter=@decreto/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "diff-coverage": "tsx tools/diff-coverage/src/bin.ts",
    "generate:trailer-clips": "tsx tools/generate-images/src/bin.ts --manifest assets/trailers/clips.json --base assets/trailers/_base.api.json --images-dir assets/trailers/clips --ext mp4 --timeout-min 60",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
